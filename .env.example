# ============================================
# LLM 配置（必填）
# ============================================
# LLM API 端点（Anthropic 兼容协议）
LLM_BASE_URL=https://your-llm-provider.example.com/v1

# LLM API 密钥（生产环境务必更换）
LLM_AUTH_TOKEN=sk-your-llm-api-key

# LLM 模型名称
MODEL_ID=qwen3.6-plus

# ============================================
# 数据库配置（MySQL，必填）
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your-db-password
DATABASE_NAME=mt4a

# ============================================
# Embedding 配置（必填）
# ============================================
# 向量嵌入 API 端点（OpenAI 兼容协议）
EMBEDDINGS_BASE_URL=https://your-embedding-provider.example.com/v1

# 向量嵌入 API 密钥
EMBEDDINGS_API_KEY=sk-your-embeddings-api-key

# 向量嵌入模型名称
EMBEDDINGS_MODEL=text-embedding-v3

# ============================================
# 可选配置
# ============================================
# 工作目录（默认当前目录）
# WORKDIR=.

# 对话上下文压缩阈值（默认 100000）
# TOKEN_THRESHOLD=100000

# NL2SQL LLM 调用最大 token 数（默认 2000）
# NL2SQL_MAX_TOKENS=2000
